/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site

/admin.html
  Cache-Control: no-store, no-cache, must-revalidate
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https://api.qrserver.com; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()

/admin.js
  Cache-Control: no-store, no-cache, must-revalidate

/admin-turnstile.js
  Cache-Control: no-store, no-cache, must-revalidate

/admin-security-log.js
  Cache-Control: no-store, no-cache, must-revalidate

/admin-session-timeout.js
  Cache-Control: no-store, no-cache, must-revalidate

/installers.html
  Cache-Control: no-store, no-cache, must-revalidate

/installers.js
  Cache-Control: no-store, no-cache, must-revalidate

/installers.css
  Cache-Control: no-store, no-cache, must-revalidate

/installers-extra.css
  Cache-Control: no-store, no-cache, must-revalidate

/installers-forgot.css
  Cache-Control: no-store, no-cache, must-revalidate

/products.html
  Cache-Control: public, max-age=300, must-revalidate

/products.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate
  Content-Type: application/manifest+json

/*.pdf
  Content-Type: application/pdf
  Cache-Control: public, max-age=604800, immutable
